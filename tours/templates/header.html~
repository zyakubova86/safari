{% block header %}
    {% load static %}

    <header class="site-header header-primary">
        <!-- header html start -->
        <div class="top-header">
            <div class="container">
                <div class="row">
                    <div class="col-lg-8 d-none d-lg-block">
                        <div class="header-contact-info">
                            <ul>
                                <li>
                                    <a href="tel:+998887156000"><i class="fas fa-phone-alt"></i>+998887156000</a>
                                </li>
                                <li>
                                    <a href="mailto:info@Travel.com"><i class="fas fa-envelope"></i> info@safaritour.com</a>
                                </li>

                            </ul>
                        </div>
                    </div>
                    <div class="col-lg-4 d-flex justify-content-lg-end justify-content-between">

                        <div class="header-social social-links">
                            <ul>
                                <li><a href="#"><i class="fab fa-telegram" aria-hidden="true"></i></a></li>
                                <li><a href="#"><i class="fab fa-facebook-f" aria-hidden="true"></i></a></li>
                                <li><a href="#"><i class="fab fa-instagram" aria-hidden="true"></i></a></li>
                            </ul>
                        </div>

                        <div class="header-social social-links">
                            <ul class="langs">

                                {% if lang == 'en' %}
                                    <li><a href="{{ request.path|slice:'3:' }}">RU</a></li>
                                    <li><strong>EN</strong></li>
                                {% else %}
                                    <li><strong>RU</strong></li>
                                    <li><a href="/en{{ request.path }}">EN</a></li>
                                {% endif %}

                                {% comment %}<li><a href="/">RU</a></li>
                                <li><a href="/en/">EN</a></li>{% endcomment %}
                            </ul>
                        </div>

                        <div class="header-search-icon">
                            <button class="search-icon">
                                <i class="fas fa-search"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="bottom-header">
            <div class="container d-flex justify-content-between align-items-center">
                <div class="site-identity">
                    <h1 class="site-title">
                        <a href="{% url 'home' %}">
                            <img class="white-logo" src="{% static 'images/travele-logo2.png' %}" alt="logo">
                            {% comment %}<img class="black-logo" src="{% static 'images/travele-logo1.png' %}" alt="logo">{% endcomment %}
                        </a>
                    </h1>
                </div>
                <div class="main-navigation d-none d-lg-block">
                    <nav id="navigation" class="navigation">
                        <ul>
                            <li class="">
                                {% if lang == 'en' %}
                                    <a href="{% url 'home_en' %}">Home</a>
                                {% else %}
                                    <a href="{% url 'home' %}">Главная</a>
                                {% endif %}
                            </li>

                            <li class="menu-item-has-children">

                                {% if lang == 'en' %}
                                    <a href="#">Tours</a>
                                    <ul>
                                        {% for category in categories %}
                                            <li>
                                                <a href="{% url 'tours_list_by_category_en' pk=category.pk %}">{{ category.name_en }}</a>
                                            </li>
                                        {% endfor %}
                                    </ul>
                                {% else %}
                                    <a href="#">Туры</a>
                                    <ul>
                                        {% for category in categories %}
                                            <li>
                                                <a href="{% url 'tours_list_by_category' pk=category.pk %}">{{ category.name }}</a>
                                            </li>
                                        {% endfor %}
                                    </ul>
                                {% endif %}
                            </li>

                            <li class="">
                                {% if lang == 'en' %}
                                    <a href="{% url 'book_ticket_en' %}">Book Flights</a>
                                {% else %}
                                    <a href="{% url 'book_ticket' %}">Авиакасса</a>
                                {% endif %}

                            </li>

                            <li>
                                {% if lang == 'en' %}
                                    <a href="{% url 'uzbekistan_en' %}">Uzbekistan</a>
                                {% else %}
                                    <a href="{% url 'uzbekistan' %}">Узбекистан</a>
                                {% endif %}
                            </li>


                            <li class="">
                                {% if lang == 'en' %}
                                    <a href="{% url 'contact_en' %}">Contact us</a>
                                {% else %}
                                    <a href="{% url 'contact' %}">Контакты</a>
                                {% endif %}

                            </li>
                        </ul>
                    </nav>
                </div>
            </div>
        </div>
        <div class="mobile-menu-container"></div>
    </header>

{% endblock %}